%     {Ideas}{Record user feedback}
%   \kanbantask[author=Carol]
%     {Ideas}{Identify compatibility risks}
%
%   \kanbantask[prio=high,author=Bob,
%     due=07/18/2026]
%     {Selected}{Approve the release scope}
%   \kanbantask[author=Carol]
%     {Selected}{Confirm supported engines}
%   \kanbantask[author=David]
%     {Selected}{Assign milestone owners}
%
%   \kanbantask[author=Carol,deadline=12/31/2099]
%     {Build}{Complete the package changes}
%   \kanbantask[author=David]
%     {Build}{Update date validation}
%   \kanbantask[author=Alice]
%     {Build}{Generate the style file}
%
%   \kanbantask[author=David]
%     {Review}{Run the technical review}
%   \kanbantask[author=Alice]
