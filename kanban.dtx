% {\large\bfseries\sffamily Abstract\par}
% \vspace{0.8em}
% \small\justifying
% The \textsf{kanban} package typesets compact project boards composed of
% named columns and task cards. A card may carry a priority, an author, a
% deadline, and a completion marker. Deadlines can be expressed either as
% calendar dates or as months relative to a project start date. Two rendering
% layouts are provided: a fixed horizontal board suited to short summaries and
% a page-breakable layout for longer task lists. Named palettes and light or
% dark board modes can be selected at package, document, or board level.
% Deadline chips distinguish overdue, current, and future values. A reference
% date can be fixed for reproducible output; otherwise the compilation date is
% used. Five common numeric date formats are available, with US notation as the
% initial default.
% This manual describes the public interface, gives complete usage examples,
% and explains the date and configuration models.
% \end{minipage}
% \vfill
% {\large Andreas Willibald Weber\par}
% \vspace{0.4em}
% {\sffamily Version \fileversion\quad--\quad\filedate\par}
% \vspace{2em}
% \end{titlepage}
% \restoregeometry
% \hypersetup{pageanchor=true}
% \pagenumbering{roman}
%
% \tableofcontents
% \clearpage
% \pagenumbering{arabic}
%
% \section{Introduction}
%
% A Kanban board represents work by assigning cards to named stages such as
% ``Backlog'', ``In progress'', and ``Done''. The package follows that model
% directly. A board uses either the built-in columns, the current document
% default, or a board-local list selected with the |columns| environment
% option. The author then assigns each task to exactly one of those columns.
% Columns are rendered in declaration order, and tasks retain their order
% within each column.
%
% The package is intended for reports, project notes, teaching material, and
% other documents in which a board should be generated from ordinary LaTeX
% source. It is not an interactive project-management system: tasks are local
% document data, and the package neither persists nor automatically moves them.
%
% \begin{tcolorbox}[
%   enhanced,
%   title={At a glance},
%   colback=kanbanSlate!4,
%   colframe=kanbanSlate!55,
%   colbacktitle=kanbanSlate,
%   coltitle=white,
%   fonttitle=\bfseries\sffamily,
%   boxrule=0.5pt,
%   arc=1mm,
%   left=4mm,right=4mm,top=3mm,bottom=3mm
% ]
% \begin{description}
% \item[Core environment] |\begin{kanban}[options]|, with board-local columns
%   selected by the |columns={...}| option when required.
% \item[Task command] |\kanbantask[options]{column}{text}|, with |\kbtask|
%   as a concise alias when that short name is available.
% \item[Shared setup] |\kanbansetup{key=value,...}|, with |\kbset| as a
%   concise alias when that short name is available.
% \item[Visual choices] Named palettes, light or dark mode, and fixed or
%   page-breakable layouts.
% \item[Date choices] US, English, German, ISO, and slash-separated year-first
%   display formats, with validated Gregorian classification.
% \item[Column geometry] Synchronized headings and transparent column bodies
%   in the fixed layout, with configurable separation.
% \end{description}
% \end{tcolorbox}
%
% \section{Requirements and installation}
%
% The package requires a LaTeX format dated 2020-10-01 or later and loads
% \textsf{xcolor}, \textsf{etoolbox}, \textsf{tikz}, \textsf{tcolorbox}, and
% \textsf{paracol}. On formats older than 2021-06-01, whose option processor
% cannot parse brace groups in package option lists, \textsf{kvoptions} is
% loaded additionally. These dependencies are included in the principal TeX
% distributions. Continuous integration runs the regression and documentation
% builds on both a current TeX Live installation and an actual TeX Live 2020
% installation. The declared format boundary is also exercised locally through
% the official \textsf{latexrelease} compatibility mechanism; the regression
% suite is run with pdfTeX, LuaTeX, and XeTeX.
%
% To install from the documented source, run
% \begin{lstlisting}
% latex kanban.ins
% \end{lstlisting}
% and copy |kanban.sty| to a directory searched by TeX. For a private
% installation, that directory is normally a suitable location below
% |TEXMFHOME|. No manual installation is necessary when the package is
% installed through a TeX distribution.
%
% Load the package in the preamble. No options are required:
% \begin{lstlisting}
% \usepackage{kanban}
% \end{lstlisting}
% Initial document defaults may also be set while loading the package:
% \begin{lstlisting}
% \usepackage[
%   columns={Planned,Active,Complete},
%   palette=muted,
%   mode=light,
%   date-format=us,
%   startdate=07/01/2026,
%   reference-date=2026-07-18,
%   columnsep=2mm
% ]{kanban}
% \end{lstlisting}
% These defaults can be changed later with |\kanbansetup| (or its concise
% alias |\kbset|) or overridden by an individual board. The following sections
% explain this hierarchy in detail.
%
% \section{The board environment}
%
% \DescribeEnv{kanban}
% The environment has the syntax
% \begin{quote}
% |\begin{kanban}[|\meta{board options}|]|\\
% \hspace*{2em}\meta{task declarations}\\
% |\end{kanban}|
% \end{quote}
% If |columns| is omitted, or if |columns={}| is supplied, the board uses the
% current document-wide column list. The package initially defines that list as
% |BACKLOG,DOING,DONE|. A non-empty comma-separated value replaces the default
% for this board only. The additional braces around the value protect its
% commas from the surrounding key list. Each name is trimmed and converted to
% uppercase before it is used as a visible heading or a lookup key.
% Task targets undergo the same conversion, so |ColName|, |colname|, |Colname|,
% and |COLNAME| all identify the same column. Column names must be unique after
% normalization and must not contain commas.
%
% Each board is independent. When a board begins, the package first resolves
% the applicable column list. It then creates an empty task list and a zero
% count for every resolved column before collecting task declarations. The
% visible board is produced only when the environment ends. This deferred
% construction is why tasks can be written in any cross-column order while
% still appearing beneath the correct headings.
%
% \subsection{Board options}
%
% The optional argument accepts the following keys.
%
% \begin{description}
% \item[|break|]
%   Selects the page-breakable layout. Each board column becomes a
%   \textsf{paracol} column with an independent colored header followed by its
%   cards. This layout is appropriate when task lists may continue onto a later
%   page. Headers are printed at the start of the board and are not repeated on
%   continuation pages.
% \item[\texttt{columns=\{}\meta{column list}\texttt{\}}]
%   Replaces the current document-wide column list for this board only. The
%   value must be enclosed in braces because it contains commas. An empty value
%   retains the current document default.
% \item[|columnsep=|\meta{length}]
%   Sets the horizontal distance between adjacent columns for this board. The
%   default is |2mm|. This value overrides the document default for the current
%   board only and is used by both the fixed and page-breakable layouts.
% \item[|palette=|\meta{name}]
%   Selects a previously defined color palette for this board. The local
%   selection does not change the palette used by later boards.
% \item[|date-format=us|, |english|, |german|, |iso|, or |ymd|]
%   Selects the numeric format used to print validated calendar dates on this
%   board. The initial default is |us|. This setting also resolves dates whose
%   slash-separated day and month are both at most 12. A local selection does
%   not change the format used by later boards.
% \item[|startdate=|\meta{date}]
%   Sets the project start date for this board. It accepts any supported
%   calendar syntax and is used only when interpreting project-month deadlines
%   such as |M2|. This value overrides the document default for the current
%   board only.
% \item[|reference-date=|\meta{date}]
%   Sets the date against which calendar and project-month deadlines are
%   classified for this board. Without this key, the package uses the TeX
%   compilation date. The exact alias |today| is also accepted. An explicit
%   reference date makes archival and automated builds reproducible.
% \item[|mode=light| or |mode=dark|]
%   Selects the visual mode for this board. The default is |light|. A local
%   mode does not change the mode of subsequent boards.
% \item[\texttt{labels=\{}\meta{label options}\texttt{\}}]
%   Replaces one or more semantic chip labels for this board. The accepted
%   nested keys are |high|, |medium|, |low|, and |done|. Omitted labels retain
%   their current document-wide values.
% \end{description}
%
% The |break| key is board-local by design; it is not accepted as a package
% option or by |\kanbansetup|. Without |break|, the package constructs a
% two-row \textsf{tcolorbox} raster inside one full-width minipage. The first
% row contains the synchronized headings and the second contains the
% synchronized column bodies. The complete board is therefore one horizontal
% object and does not break naturally across pages. This default is preferable
% for compact boards. Task cards occupy the complete available width of the
% column body in both layouts.
%
% \subsection{A first board}
%
% The following complete example applies the environment syntax and default
% fixed layout described above. Because no column list is supplied, it uses
% the built-in |BACKLOG|, |DOING|, and |DONE| stages and assigns one task to
% each stage. The deliberately varied capitalization of the task targets also
% demonstrates case-insensitive assignment.
% \begin{lstlisting}
% \begin{kanban}
%   \kanbantask[prio=high,author=Alice]
%     {backlog}{Agree on the public API}
%   \kanbantask[due=07/31/2026]
%     {DoInG}{Write the implementation}
%   \kanbantask[completed]
%     {DONE}{Create the repository}
% \end{kanban}
% \end{lstlisting}
%
% The example produces the following board:
%
% \begin{kanban}
%   \kanbantask[prio=high,author=Alice]
%     {backlog}{Agree on the public API}
%   \kanbantask[due=07/31/2026]
%     {DoInG}{Write the implementation}
%   \kanbantask[completed]
%     {DONE}{Create the repository}
% \end{kanban}
%
% \section{Configuration hierarchy}
%
% The package uses a consistent hierarchy for column lists, palettes, visual
% modes, date formats, project start dates, reference dates, semantic labels,
% and column separation. This
% makes document-wide settings easy to reuse while keeping local exceptions
% explicit.
%
% \begin{enumerate}
% \item Package options establish the initial defaults.
% \item |\kanbansetup| changes the defaults for boards that follow it.
% \item Environment options override the defaults for one board only, including
%   the board-local |columns| key.
% \end{enumerate}
%
% The most local value has priority. For example:
% \begin{lstlisting}
% \usepackage[
%   columns={Planned,Active,Complete},
%   palette=muted,
%   mode=light,
%   date-format=us,
%   reference-date=2026-07-18,
%   columnsep=2mm
% ]{kanban}
%
% % Uses every package default, including the configured columns.
% \begin{kanban}
%   ...
% \end{kanban}
%
% % Changes defaults for subsequent boards.
% \kbset{
%   columns={Queued,Processing,Stored},
%   palette=monochrome,
%   mode=dark,
%   date-format=iso,
%   reference-date=2026-07-18,
%   columnsep=1.5mm
% }
%
% % Uses the revised document defaults.
% \begin{kanban}
%   ...
% \end{kanban}
%
% % Uses local columns, default palette, light mode, English dates, and a 3 mm gap.
% \begin{kanban}[
%   columns={Todo,Doing,Done},
%   palette=default,mode=light,date-format=english,columnsep=3mm
% ]
%   ...
% \end{kanban}
%
% % Uses Queued, Processing, and Stored again.
% \begin{kanban}
%   ...
% \end{kanban}
% \end{lstlisting}
%
% \DescribeMacro{\kanbansetup}
% The setup command accepts a comma-separated key list:
% \begin{quote}
% |\kanbansetup{columns={|\meta{column list}|},palette=|\meta{name}|,|\\
% \hspace*{2em}|mode=|\meta{mode}|,date-format=|\meta{format}|,|\\
% \hspace*{2em}|startdate=|\meta{date}|,reference-date=|\meta{date}|,|\\
% \hspace*{2em}|columnsep=|\meta{length}|,labels={|\meta{label options}|}}|
% \end{quote}
% When the name is available, the shorter |\kbset| command is an exact alias.
% The longer name is the canonical form because it is less likely to conflict
% with another package. If |\kbset| already exists when \textsf{kanban} is
% loaded, the package preserves the existing definition, issues a warning, and
% leaves |\kanbansetup| fully available.
% A key may be omitted when its current value should remain unchanged. Setup
% calls affect later boards; they do not redraw boards that have already been
% typeset. The |columns| value must be enclosed in braces because it is itself
% a comma-separated list. An empty |columns| value is rejected with a warning,
% and the previous document default remains active.
%
% \subsection{Default column lists}
%
% With no configuration, every board that omits its |columns| option uses the
% three columns |BACKLOG|, |DOING|, and |DONE|. This provides a useful
% conventional board without requiring repeated declarations:
% \begin{lstlisting}
% \begin{kanban}
%   \kanbantask{backlog}{Record the request}
%   \kanbantask{Doing}{Prepare the response}
%   \kanbantask{dOnE}{Archive the decision}
% \end{kanban}
% \end{lstlisting}
%
% A document can establish different defaults when the package is loaded:
% \begin{lstlisting}
% \usepackage[columns={Planned,Active,Complete}]{kanban}
% \end{lstlisting}
% or change them from a particular point onward:
% \begin{lstlisting}
% \kbset{columns={Queued,Processing,Stored}}
% \end{lstlisting}
% In both cases, later environments may omit the |columns| key. Supplying a
% board-local key remains the appropriate way to describe an exceptional board:
% \begin{lstlisting}
% \begin{kanban}[columns={Requested,Approved,Rejected}]
%   ...
% \end{kanban}
% \end{lstlisting}
% This option is local; it does not change the default used by the next
% environment. Letter case need not match because both declarations and task
% targets are normalized to uppercase. Other differences remain significant;
% for example, |IN REVIEW| and |REVIEW| are distinct identifiers. If a list
% repeats a name after normalization, the package reports an error, retains the
% first occurrence, and ignores the repeated occurrence. This recovery permits
% the remaining unique columns to be rendered if compilation is continued.
%
% \section{Declaring tasks}
%
% \DescribeMacro{\kanbantask}
% \SpecialUsageIndex{\kbtask}
% A task declaration has the syntax
% \begin{quote}
% |\kanbantask[|\meta{task options}|]{|\meta{column}|}{|\meta{text}|}|
% \end{quote}
% When the name is available, |\kbtask| is an exact alias with the same
% signature and behavior. The longer |\kanbantask| name is the canonical
% interface because it is less likely to conflict with another package. If
% |\kbtask| already exists when \textsf{kanban} is loaded, the package
% preserves the existing definition, issues a warning, and leaves
% |\kanbantask| fully available.
% The column must have been declared by the enclosing board. Surrounding spaces
% are removed and letters are converted to uppercase before lookup, making the
% assignment case-insensitive. The task text is ordinary LaTeX material and may
% contain emphasis, citations, and other commands suitable for a |tcolorbox|.
% Fragile or unusually complex material should be tested in the intended
% document class.
%
% The column argument may not be empty. A missing assignment or a normalized
% name that is absent from the board produces a package error. The diagnostic
% identifies the invalid input, lists the valid normalized columns, and explains
% how to correct the declaration. The invalid task is not counted or rendered,
% which leaves the remaining board data structurally consistent if compilation
% is continued after the error. A task declared outside a |kanban| environment
% similarly produces a direct error instead of modifying residual board data.
%
% For example, both tasks below are assigned to the single displayed column
% |RESEARCH|:
% \begin{lstlisting}
% \begin{kanban}[columns={Research,Review}]
%   \kanbantask{research}{Collect the evidence}
%   \kanbantask{ReSeArCh}{Document the method}
% \end{kanban}
% \end{lstlisting}
% By contrast, the following fragments are invalid:
% \begin{lstlisting}
% \kanbantask{}{A task without a target}
% \kanbantask{Archive}{A task for an undeclared stage}
% \end{lstlisting}
% For a board containing |RESEARCH| and |REVIEW|, the corresponding errors state
% that the first task has no assigned column and that |Archive| is unknown; both
% diagnostics also report |RESEARCH,REVIEW| as the valid column set.
%
% The package deliberately does not define the generic |\task| alias. That name
% is used by several document classes and packages; leaving it untouched
% prevents load-order-dependent conflicts. The namespaced |\kbtask| form
% provides a concise alternative without claiming the generic name.
%
% \subsection{Task options}
%
% \begin{description}
% \item[|prio=high|]
%   Adds a red high-priority pill, labelled \textsc{high} by default.
% \item[|prio=medium| or |prio=med|]
%   Adds an orange medium-priority pill, labelled \textsc{med} by default.
% \item[|prio=low|]
%   Adds a green low-priority pill, labelled \textsc{low} by default.
% \item[|author=|\meta{text}]
%   Places a neutral author chip at the right of the metadata row.
% \item[|deadline=|\meta{value}]
%   Adds a deadline chip beneath the metadata row. The alias |due| has exactly
%   the same meaning.
% \item[|late|]
%   Forces an existing deadline chip to use the overdue style. The option has
%   no visible effect unless |deadline| or |due| is also present.
% \item[|completed|]
%   Adds a green marker, labelled \textsc{done} by default. Completion is
%   presentational: it does not move the task or suppress its deadline.
% \end{description}
%
% Task options are local to one declaration. Unknown option names generate a
% package warning. Priority values are trimmed and compared without regard to
% letter case. An unrecognized value produces a warning and no priority pill.
%
% Several options may be combined in one declaration:
% \begin{lstlisting}
% \kanbantask[
%   prio=high,
%   author=Alice,
%   due=07/31/2026
% ]{Review}{Approve the release candidate}
% \end{lstlisting}
% The package does not infer workflow state from metadata. In particular,
% |completed| adds a marker but does not move the task to a column named
% ``Done''. The column argument remains the only source of task placement.
%
% Task text may contain ordinary inline markup:
% \begin{lstlisting}
% \kanbantask{Doing}{
%   Compare \emph{pdfLaTeX} and \emph{LuaLaTeX} output
% }
% \end{lstlisting}
% Authors should keep card text concise. Long paragraphs are valid, but they
% make narrow boards difficult to scan.
%
% \section{Deadline semantics}
%
% Deadline classification is performed when a card is rendered. By default,
% the comparison day is obtained from the TeX primitives |\year|, |\month|,
% and |\day|. Consequently, recompiling the same source on a later date may
% change a deadline chip from neutral to current or overdue. The
% |reference-date| key replaces that moving comparison day with a validated,
% fixed date when reproducible output is required.
%
% \subsection{Calendar dates}
%
% A deadline is interpreted as a calendar date when its complete expanded
% value has one of the supported numeric forms. The parser recognizes
% month-first and day-first dates with a final year, German dot notation, ISO
% notation, and slash-separated year-first notation. For example:
% \begin{lstlisting}
% \kanbantask[due=07/31/2026]{Review}{Approve the release}
% \kanbantask[due=2026-08-15]{Planned}{Archive the release}
% \end{lstlisting}
% A date before the active reference date is red, a date equal to it is orange,
% and a future date is neutral. When no reference date has been configured, the
% compilation date is the active reference. Dates are checked against the
% Gregorian month lengths, including the leap-year rule, for years from 1 to
% 9999. A numeric value that has recognized date syntax but does not denote a
% valid date produces a warning and is retained as a neutral label. Other
% descriptive values, including labels beginning with |M| or containing
% punctuation, are displayed without automatic classification; |late| may be
% used when such a label must appear overdue.
%
% \subsection{Date formats}
%
% The |date-format| key selects how every validated calendar date is printed.
% The package provides five common numeric conventions:
%
% \begin{center}
% \begin{tabular}{@{}lll@{}}
% \textbf{Key value} & \textbf{Convention} & \textbf{18 July 2026} \\
% \hline
% |us|      & month/day/year       & |07/18/2026| \\
% |english| & day/month/year       & |18/07/2026| \\
% |german|  & day.month.year       & |18.07.2026| \\
% |iso|     & year-month-day       & |2026-07-18| \\
% |ymd|     & year/month/day       & |2026/07/18| \\
% \end{tabular}
% \end{center}
%
% |us| is the initial default. Output components are zero-padded, so a valid
% input such as |2026-7-8| is not treated as ISO syntax, whereas |2026-07-08|
% is recognized and printed as |07/08/2026| under the default. Selecting a
% format follows the same three-level hierarchy as the other board settings:
% \begin{lstlisting}
% \usepackage[date-format=english]{kanban} % initial document default
% \kbset{date-format=german}               % subsequent boards
%
% \begin{kanban}[date-format=iso]           % this board only
%   ...
% \end{kanban}
% \end{lstlisting}
% The compact spelling |dateformat| is accepted as an exact key alias, although
% |date-format| is the canonical spelling used throughout this manual. Format
% values are trimmed and compared without regard to letter case. The canonical
% values in the table should be preferred in new documents. For compatibility,
% |american| maps to |us|; |uk| and |british| map to |english|; |de| and
% |deutsch| map to |german|; and |year-first| maps to |ymd|.
%
% Calendar parsing is intentionally more permissive than display formatting:
% an unambiguous date in any supported notation is accepted and normalized to
% the selected output convention. A year-last slash date can be ambiguous; for
% example, |07/08/2026| denotes either 8 July or 7 August. The |english| and
% |german| selections interpret such a value as day/month/year. The |us|,
% |iso|, and |ymd| selections use month/day/year for this otherwise ambiguous
% input. If only one ordering denotes a valid Gregorian date, that ordering is
% accepted regardless of the current selection. ISO input is consequently the
% safest form for task data exchanged between documents, because its component
% order is unambiguous. Project-month values such as |M2| and descriptive
% labels are never reformatted.
%
% The |startdate| and |reference-date| settings are normalized to an internal
% ISO representation as soon as their containing key list has been processed.
% Their values are therefore immutable snapshots: a later macro redefinition
% or board-local display-format change cannot reinterpret an inherited date.
% Within one package, setup, or board option list, |date-format| is resolved
% before either stored date is normalized, irrespective of the textual order
% of those keys. Task deadlines remain board data and are interpreted under the
% board's selected format when their cards are rendered.
%
% \subsection{Project months}
%
% A complete value of the form |M|\meta{n}, where \meta{n} is an integer from
% 1 to 999999, denotes project month \meta{n}. The upper bound keeps malformed
% input outside TeX's integer arithmetic. Values outside this range remain
% neutral labels. The initial project start date may
% be supplied as a package option:
% \begin{lstlisting}
% \usepackage[startdate=07/15/2026]{kanban}
% \end{lstlisting}
% It may be changed for subsequent boards through the common setup interface:
% \begin{lstlisting}
% \kbset{startdate=2026-07-15}
% \end{lstlisting}
% Finally, a board can override the default locally:
% \begin{lstlisting}
% \begin{kanban}[columns={Planned,Active,Done},startdate=07/15/2026]
% \end{kanban}
% \end{lstlisting}
% The precedence order is therefore board option, current |\kbset| default,
% and package option. A board-local value does not alter subsequent boards.
% An empty setup value clears the persistent start date for later boards;
% an empty board value disables an inherited start date for that board only:
% \begin{lstlisting}
% \kbset{startdate={}}
% \begin{kanban}[startdate={}]
%   ...
% \end{kanban}
% \end{lstlisting}
% Accepted start dates are stored canonically rather than as their original
% input tokens. For example, a US |07/08/2026| start date remains 8 July even
% if a later board selects |date-format=english| for its visible deadlines.
% This separation prevents a display preference from changing project-month
% boundaries.
%
% Project months begin on the day number of the start date. Thus, for a project
% beginning on 15 July, |M1| runs from 15 July until 14 August and |M2| begins
% on 15 August. If that day does not exist in a later calendar month, the
% boundary is clamped to the final valid day of that month. A project beginning
% on 31 January therefore enters |M2| on 28 February, or on 29 February in a
% leap year; its following boundary is 31 March. This rule prevents a short
% month from extending the preceding project month unintentionally.
%
% A project month earlier than the current one is overdue; the current project
% month is orange; and a later month is neutral. If no start date is available,
% the value is displayed without automatic classification. An invalid start
% date produces a package warning and does not replace the previously valid
% value.
%
% \subsection{Reproducible reference dates}
%
% The optional |reference-date| setting fixes the comparison day used by both
% calendar deadlines and project months. It follows the same package, setup,
% and board-local hierarchy as |startdate|:
% \begin{lstlisting}
% \usepackage[reference-date=2026-07-18]{kanban}
% \kbset{reference-date=2026-08-01}
%
% \begin{kanban}[reference-date=2026-08-15]
%   ...
% \end{kanban}
% \end{lstlisting}
% The key alias |today| has exactly the same meaning. An empty setup value
% restores the compilation date for later boards, while an empty board value
% restores it for that board only. Like a project start date, an accepted
% reference date is validated, expanded, and stored canonically. Invalid input
% produces a warning and preserves the preceding value. This facility is
% useful for archived reports, regression tests, and automated publication
% systems in which a rebuild should not alter status colors.
%
% \subsection{Worked deadline example}
%
% The following board uses both public key names and displays all three visual
% states with calendar dates. The manual fixes its reference date as 18 July
% 2026, so the first date lies in the past, the second equals the reference
% date, and the third lies in the future.
% \begin{lstlisting}
% \begin{kanban}[columns={Overdue,Due now,Upcoming}]
%   \kanbantask[deadline=01/01/2000]
%     {Overdue}{Resolve the review comments}
%   \kanbantask[due=07/18/2026]
%     {Due now}{Complete the current milestone}
%   \kanbantask[deadline=2099-12-31]
%     {Upcoming}{Prepare the next milestone}
% \end{kanban}
% \end{lstlisting}
% The red chip denotes a past date, the orange chip denotes the active reference
% date, and the neutral chip denotes a future date. The first and third values
% also demonstrate US and ISO calendar input. Both are printed in the selected
% format, which is US notation here because the board uses the default. The keys
% |deadline| and |due| are exact aliases; their choice does not determine the
% color. The fixed reference date keeps the rendered result stable whenever the
% manual is compiled.
%
% \begin{kanban}[columns={Overdue,Due now,Upcoming}]
%   \kanbantask[deadline=01/01/2000]
%     {Overdue}{Resolve the review comments}
%   \kanbantask[due=07/18/2026]
%     {Due now}{Complete the current milestone}
%   \kanbantask[deadline=2099-12-31]
%     {Upcoming}{Prepare the next milestone}
% \end{kanban}
%
% A complete version of this demonstration, in both light and dark mode, is
% provided as |kanban-deadlines-example.tex|.
%
% \section{Color and layout model}
%
% By default, columns draw from an eight-color palette in declaration order:
% slate, blue, teal, sage, amber, clay, rose, and plum. A selected custom
% palette may contain a different number of colors. When the number of columns
% exceeds the number of entries, the palette repeats. Priority and status
% colors are independent of the column color.
%
% In the default layout, the nominal width of each column is calculated from
% the available line width and the number of columns. Large boards can
% therefore become too narrow for useful text. In practice, three or four
% columns fit comfortably in portrait documents; wider boards often benefit
% from landscape orientation, a larger paper size, or the |break| layout.
%
% \subsection{Selecting a palette}
%
% Version 1.0.0 provides named palettes. The initial palette may be selected as
% a package option:
% \begin{lstlisting}
% \usepackage[palette=muted]{kanban}
% \end{lstlisting}
% The built-in names are |default|, |muted|, and |monochrome|. The |default|
% palette contains the original eight-color sequence.
%
% |\kbset{palette=|\meta{name}|}| changes the default for subsequent boards:
% \begin{lstlisting}
% \kbset{palette=monochrome}
% \end{lstlisting}
% A board may override that default without changing later boards:
% \begin{lstlisting}
% \begin{kanban}[columns={Todo,Doing,Done},palette=default]
%   ...
% \end{kanban}
% \end{lstlisting}
%
% \DescribeMacro{\kbdefinepalette}
% \SpecialUsageIndex{\kanbandefinepalette}
% A new palette is registered with
% \begin{quote}
% |\kanbandefinepalette{|\meta{name}|}{|\meta{color list}|}|
% \end{quote}
% where the second argument is a non-empty, comma-separated list of colors or
% \textsf{xcolor} expressions. For example:
% \begin{lstlisting}
% \definecolor{universityBlue}{HTML}{164A7B}
% \definecolor{universityGold}{HTML}{A67C00}
% \kbdefinepalette{university}{
%   universityBlue,
%   teal!70!black,
%   universityGold
% }
% \kbset{palette=university}
% \end{lstlisting}
% The unstarred form uses white heading text for every entry. If a palette
% contains both dark and light backgrounds, the starred form records an
% explicit foreground color with each background:
% \begin{quote}
% |\kanbandefinepalette*{|\meta{name}|}{|%
% \meta{background}|/|\meta{foreground}|,...}|
% \end{quote}
% For example:
% \begin{lstlisting}
% \kbdefinepalette*{accessible}{
%   facultyNavy/white,
%   facultyGold/kanbanInk,
%   facultyBerry/white
% }
% \end{lstlisting}
% The slash separates the two \textsf{xcolor} expressions. Every entry in a
% starred definition must contain exactly one slash and two non-empty values;
% otherwise the complete definition is rejected with a warning. This explicit
% pairing permits suitable heading contrast for arbitrary custom colors. It
% does not attempt to calculate or certify a contrast ratio, because
% \textsf{xcolor} expressions may depend on the surrounding document's color
% model and named-color definitions.
% When its name is available, the concise command |\kbdefinepalette| is an
% exact alias. If another package has already defined that name,
% \textsf{kanban} preserves it, reports a warning, and requires the canonical
% |\kanbandefinepalette| command. Surrounding spaces in a palette name are
% ignored, but palette names are case-sensitive. Palette registration is
% document-wide: the definition command creates or replaces a named registry
% entry, while package, setup, and board |palette| keys only select an existing
% entry.
% Defining an existing name replaces its stored color list. If that name is the
% current document default, later boards immediately use the replacement; the
% name does not need to be selected again. A board takes a local snapshot of
% the palette and its foreground list when it begins, so redefining the name
% while that board is being collected cannot alter the board already in
% progress. An unknown or empty palette produces a warning and leaves the
% current selection unchanged.
%
% A palette may contain any positive number of colors. When a board has more
% columns than the palette has entries, selection wraps cyclically. A
% three-color palette is therefore applied as colors 1, 2, 3, 1, 2, 3, and so
% forth. The built-in colors are dark enough to give white heading text a
% contrast ratio of at least 4.5:1. Authors of custom palettes remain
% responsible for preserving adequate contrast; the starred interface makes
% the foreground choice explicit for every palette entry. The following
% example defines a three-color institutional palette with dark text on its
% lighter gold background. Since the board has four columns, its
% fourth heading reuses the first palette entry.
% \begin{lstlisting}
% \definecolor{facultyNavy}{HTML}{244A6C}
% \definecolor{facultyGold}{HTML}{C69A32}
% \definecolor{facultyBerry}{HTML}{843D60}
% \kbdefinepalette*{faculty}{
%   facultyNavy/white,
%   facultyGold/kanbanInk,
%   facultyBerry/white
% }
%
% \begin{kanban}[
%   columns={Proposed,Selected,In progress,Published},
%   palette=faculty
% ]
%   \kanbantask[deadline=12/31/2099]
%     {Proposed}{Collect research questions}
%   \kanbantask[prio=high,deadline=01/01/2000]
%     {Selected}{Approve the study design}
%   \kanbantask[author=Alice,
%     due=07/18/2026]
%     {In progress}{Complete the analysis}
%   \kanbantask[completed]{Published}{Deposit the article}
% \end{kanban}
% \end{lstlisting}
% It produces the following board:
%
% \definecolor{kbManualNavy}{HTML}{244A6C}
% \definecolor{kbManualGold}{HTML}{C69A32}
% \definecolor{kbManualBerry}{HTML}{843D60}
% \kbdefinepalette*{manualfaculty}{
%   kbManualNavy/white,
%   kbManualGold/kanbanInk,
%   kbManualBerry/white
% }
% \begin{kanban}[
%   columns={Proposed,Selected,In progress,Published},
%   palette=manualfaculty
% ]
%   \kanbantask[deadline=12/31/2099]
%     {Proposed}{Collect research questions}
%   \kanbantask[prio=high,deadline=01/01/2000]
%     {Selected}{Approve the study design}
%   \kanbantask[author=Alice,
%     due=07/18/2026]
%     {In progress}{Complete the analysis}
%   \kanbantask[completed]{Published}{Deposit the article}
% \end{kanban}
%
% The complete compilable source is |kanban-palette-example.tex|.

% \subsection{Column geometry}
%
% The |columnsep| key accepts either a non-negative explicit TeX dimension,
% such as |2mm| or |0.5em|, or a single registered dimension such as
% |\linewidth|. It controls the distance between adjacent columns, and its
% default value is |2mm|. Malformed values are rejected with a package warning
% before TeX's dimension scanner is entered, so they do not produce secondary
% ``missing number'' or ``illegal unit'' errors. An initial value may be set as
% a package option:
% \begin{lstlisting}
% \usepackage[columnsep=3mm]{kanban}
% \end{lstlisting}
% It may be changed for subsequent boards with the shared setup command:
% \begin{lstlisting}
% \kbset{columnsep=1.5mm}
% \end{lstlisting}
% A single board may override the current default without affecting later
% boards:
% \begin{lstlisting}
% \begin{kanban}[columns={Todo,Doing,Done},columnsep=4mm]
%   ...
% \end{kanban}
% \end{lstlisting}
% The same value is applied to the fixed layout and to the column separation
% used by the |break| layout. In the fixed layout the package subtracts the
% total separation from the available line width before dividing the remaining
% width among the columns. Each task card then occupies the complete available
% width of its column body.
%
% The value must also be feasible for the resolved number of columns. For
% \meta{n} columns, the product of \meta{n} minus one and |columnsep| must be
% smaller than |\linewidth|. If the total gap is equal to or wider than the
% available line width, the package reports an error and uses |0pt| for that
% board. This recovery value preserves positive column width while leaving the
% document-wide default unchanged.
%
% The fixed layout is constructed as a two-row raster. All heading cells use
% the height of the tallest heading, including headings that wrap onto more
% than one line. All column bodies use the height of the body containing the
% most material, so empty or short columns extend to the same bottom edge. The
% column body itself is transparent in both visual modes; only its bottom rule
% remains visible, while the left and right rules are omitted. Task cards keep
% their light or dark background, border, and colored accent.
%
% Equal-height measurements are stored in the document's auxiliary file.
% Authors should therefore compile the document twice after changing a column
% heading or task list. In the page-breakable layout, heading heights are also
% synchronized at the beginning of the board, but column bodies remain
% independent so that they can continue naturally across pages. The initial
% headings are not repeated on continuation pages.
%
% The following example uses concise headings and includes an empty column. The
% shorter labels are preferable in narrow boards because they keep the workflow
% stages visually compact; longer headings remain supported and are equalized
% automatically when wrapping is unavoidable.
% \begin{lstlisting}
% \begin{kanban}[columns={Queued,Review,Complete}]
%   \kanbantask[prio=high]{Review}
%     {Prepare the response}
%   \kanbantask{Review}
%     {Check the revised figures}
%   \kanbantask[completed]{Complete}{Approve the revision}
% \end{kanban}
% \end{lstlisting}
% \Needspace{10\baselineskip}
% It produces a board whose headings and bottom edges remain aligned:
%
% \begin{kanban}[columns={Queued,Review,Complete}]
%   \kanbantask[prio=high]{Review}
%     {Prepare the response}
%   \kanbantask{Review}
%     {Check the revised figures}
%   \kanbantask[completed]{Complete}{Approve the revision}
% \end{kanban}
%
% \subsection{Light and dark modes}
%
% The default |light| mode uses dark text on white cards, neutral gray metadata
% chips, and white headings on the selected palette colors. The |dark| mode
% uses light text on dark cards. Author chips and neutral |deadline| or |due|
% chips deliberately retain their light-mode colors in both modes, giving
% metadata a stable visual identity. Automatic status colors remain semantic:
% overdue values are red and values due now are amber in either mode. In both
% modes the area behind the cards is transparent, so the surrounding page
% remains visible in the vertical space between cards and at the foot of a
% synchronized column. Palette colors continue to identify columns in both
% modes.
%
% The initial mode may be selected as a package option:
% \begin{lstlisting}
% \usepackage[mode=dark]{kanban}
% \end{lstlisting}
% It can be changed for subsequent boards through the common setup interface:
% \begin{lstlisting}
% \kbset{mode=dark}
% \end{lstlisting}
% A board may then override that default locally:
% \begin{lstlisting}
% \begin{kanban}[columns={Todo,Doing,Done},mode=light]
%   ...
% \end{kanban}
% \end{lstlisting}
%
% Mode selection affects only the board. It deliberately does not call
% |\pagecolor| and does not alter the surrounding document text. A dark board
% can therefore be embedded safely in an otherwise light document. Unknown
% mode names produce a warning and leave the current selection unchanged.
%
% The examples section below compares the two modes with identical column
% geometry and explicit deadline states. A separate custom-palette example is
% provided as |kanban-palette-example.tex|.
%
% \subsection{Labels and public style hooks}
%
% The visible semantic labels can be adapted without redefining internal
% commands. The |labels| key accepts the nested keys |high|, |medium|, |low|,
% and |done|. It follows the same package, setup, and board-local precedence as
% the other configuration keys:
% \begin{lstlisting}
% \usepackage[
%   labels={high=URGENT,medium=NORMAL,low=ROUTINE,done=FINISHED}
% ]{kanban}
%
% \kbset{labels={done=APPROVED}}
%
% \begin{kanban}[labels={high=IMMEDIATE}]
%   ...
% \end{kanban}
% \end{lstlisting}
% A board takes a snapshot of all four labels when it begins. An omitted label
% keeps its current value; an empty value is rejected with a warning. Label
% text is ordinary short LaTeX material, although concise uppercase terms are
% normally easiest to read inside the small chips.
%
% Seven namespaced \textsf{tcolorbox} styles provide a controlled extension
% point for typographic and spacing changes:
% \begin{quote}
% |kanban/header|, |kanban/card|, |kanban/column-body|;\\
% |kanban/priority-chip|, |kanban/author-chip|;\\
% |kanban/deadline-chip|, |kanban/completed-chip|.
% \end{quote}
% The styles are initially empty and are applied after the structural package
% defaults. For example:
% \begin{lstlisting}
% \tcbset{
%   kanban/header/.append style={fontupper=\bfseries\sffamily},
%   kanban/card/.append style={arc=1mm,outer arc=1mm},
%   kanban/author-chip/.append style={left=1.5mm,right=1.5mm}
% }
% \end{lstlisting}
% These hooks are document-wide \textsf{tcolorbox} settings. The header, card,
% and chip styles apply to both rendering strategies. |kanban/column-body|
% applies only to the fixed renderer because the page-breakable renderer leaves
% each \textsf{paracol} stream without an enclosing body box. Authors should
% preserve |width=\linewidth| for cards and should test changes to padding in
% narrow columns. The named colors |kanbanHigh|, |kanbanMed|, and |kanbanLow|
% remain available to advanced users, but changing either foreground or
% background colors also transfers responsibility for readable contrast to the
% document author. In the defaults, the orange medium and due-now chips use
% dark ink; the red and green semantic chips use white. Together with the
% revised built-in palettes, these pairs meet a 4.5:1 reference contrast ratio
% for ordinary text.
%
% \section{Diagnostics and limitations}
%
% Unknown setup, board, and task options generate package warnings. Unknown
% palettes and modes preserve the current selection; an unknown priority is
% omitted. Empty semantic labels preserve the preceding value. A numeric
% deadline that resembles a calendar date or project month but is outside the
% validated range is displayed neutrally and produces a warning; descriptive
% labels remain neutral without a diagnostic. A malformed or negative
% |columnsep| value is rejected with one package warning and preserves the
% current value; malformed input is intercepted before TeX emits a low-level
% number or unit error. A non-negative separation whose combined gaps leave no column width
% produces an error and is replaced by |0pt| for the affected board. A task with an
% empty column argument, a task outside a board, a task assigned to an
% undeclared normalized name, or a column list containing a duplicate after
% case normalization generates a package error with corrective help. Duplicate
% names recover by keeping the first normalized occurrence and discarding later
% occurrences. Nested
% |kanban| environments are also rejected because each board owns one active
% collection context. The nested environment produces one error; task
% declarations inside it are then ignored without a cascade of secondary
% ``outside a board'' errors. Invalid tasks are neither counted nor rendered. This
% distinction reserves errors for
% declarations that cannot be interpreted unambiguously while allowing harmless
% option diagnostics to remain recoverable warnings.
% The optional short commands |\kbtask|, |\kbset|, and |\kbdefinepalette| are
% installed only when their names are unused. A pre-existing definition is
% never overwritten; the canonical long command remains available in every
% case.
%
% Authors should also observe the following constraints.
% \begin{itemize}
% \item The resolved default or explicit list must contain at least one column.
%   The built-in default satisfies this requirement, and an empty value passed
%   to the |columns| setup key is rejected.
% \item Column identifiers are converted to uppercase and compared without
%   regard to letter case. They must not contain commas and must remain unique
%   after normalization.
% \item Mode and priority values are trimmed and compared without regard to
%   letter case. Date-format values and their documented aliases follow the
%   same normalization rule. Palette names remain case-sensitive.
% \item Column separation must be a non-negative explicit dimension or a
%   single registered dimension, and the sum of all inter-column gaps must be
%   smaller than the available line width.
% \item Calendar dates, project start dates, and reference dates may use US or English
%   slash notation with a final year, German dot notation, ISO hyphen
%   notation, or slash-separated year-first notation. Ambiguous year-last
%   slash dates follow the selected date format. Calendar dates are validated
%   for years from 1 to 9999 and are normalized for display.
% \item Only complete calendar dates and values |M1| through |M999999| are
%   classified automatically. All other deadline values are treated as labels
%   and remain neutral unless |late| is present. The |M| in a project-month
%   value is uppercase and case-sensitive.
% \item The fixed raster layout cannot split an individual board across pages;
%   use |break| for long boards.
% \item The |break| layout prints synchronized headings once at the beginning
%   of the board. It does not repeat them on continuation pages because the
%   supported \textsf{paracol} interface provides independent column streams,
%   not a repeating per-column heading row.
% \item The |break| layout should not be used inside a
%   \textsf{pdflscape} |landscape| environment. Use the fixed layout for a
%   landscape board and ensure that the complete board fits on that page.
% \item Task counts include every successfully assigned task, irrespective of
%   its completion status.
% \end{itemize}
%
% \section{Further usage examples}
%
% The distribution contains eight independently compilable example documents.
% The general overview is |kanban-example.tex|; the remaining files isolate
% deadline states, date formats, custom palettes, visual modes, column
% separation, page breaking, and landscape composition.
% This section reproduces the essential source for each case and, where visual
% behaviour is central, places the generated output directly below it. The
% resulting comparison makes the effect of each option observable without
% requiring the reader to compile a separate file.
%
% \subsection{Reusable document setup}
%
% A document containing several related boards should establish common values
% at the highest appropriate configuration level. Package options provide the
% initial policy, while environment options record deliberate exceptions. The
% following example keeps the column list, palette, mode, project start date,
% reference date, and column separation consistent across the document, but gives the second board
% a local column list and a different mode:
% \begin{lstlisting}
% \documentclass{article}
% \usepackage[
%   columns={Planned,Active,Complete},
%   palette=muted,
%   mode=light,
%   startdate=07/01/2026,
%   reference-date=2026-07-18,
%   columnsep=2mm
% ]{kanban}
%
% \begin{document}
%
% \section{Research tasks}
% \begin{kanban}
%   \kanbantask[prio=high,author=Alice,due=M1]
%     {Planned}{Validate the data set}
%   \kanbantask[author=Bob,due=M2]
%     {Active}{Draft the results section}
%   \kanbantask[completed]
%     {Complete}{Approve the analysis plan}
% \end{kanban}
%
% \section{Archival tasks}
% \begin{kanban}[columns={Queued,Processing,Stored},mode=dark]
%   \kanbantask{Queued}{Deposit the source data}
%   \kanbantask[author=Carol]{Processing}{Create metadata records}
% \end{kanban}
%
% \end{document}
% \end{lstlisting}
% The first board inherits every package default, including the configured
% column list. The second board inherits the |muted| palette, project start
% date, and column separation, while replacing its columns and visual mode for
% that board only. This pattern makes document-wide conventions explicit and
% keeps local deviations easy to identify during review.
%
% \Needspace{18\baselineskip}
% \subsection{Selecting a date format}
%
% A shared date convention should normally be established at package or setup
% level. A board-local selection is useful when a report reproduces material
% prepared for a different audience. The following source uses ISO input for
% every task because that form is unambiguous, then requests each available
% output convention independently:
% \begin{lstlisting}
% \begin{kanban}[columns={Upcoming},date-format=us]
%   \kanbantask[due=2099-07-18]
%     {Upcoming}{Prepare the scheduled release}
% \end{kanban}
%
% \begin{kanban}[columns={Upcoming},date-format=english]
%   \kanbantask[due=2099-07-18]
%     {Upcoming}{Prepare the scheduled release}
% \end{kanban}
%
% % The same structure also accepts german, iso, and ymd.
% \end{lstlisting}
% Only the printed date changes; validation and overdue classification use the
% same Gregorian components in all five cases.
%
% \paragraph{Rendered output.}
% The boards below render the same future date. The labels state the component
% order explicitly so that the result does not depend on national terminology.
%
% \noindent
% \kanbanManualDateFormatBoard{us}{US: MM/DD/YYYY}
% \hfill
% \kanbanManualDateFormatBoard{english}{English: DD/MM/YYYY}
%
% \medskip
%
% \noindent
% \kanbanManualDateFormatBoard{german}{German: DD.MM.YYYY}
% \hfill
% \kanbanManualDateFormatBoard{iso}{ISO: YYYY-MM-DD}
%
% \medskip
%
% \noindent
% \kanbanManualDateFormatBoard{ymd}{Year first: YYYY/MM/DD}
%
% The complete compilable source is |kanban-date-formats-example.tex|. It also
% shows how the five compact boards can be arranged in minipages without
% changing their local configuration scope.
%
% \Needspace{18\baselineskip}
% \subsection{Light and dark boards in one document}
%
% Visual mode is a property of the cards rather than of the page. Selecting
% |dark| therefore changes card backgrounds, text, and borders
% without changing the surrounding document or the transparent column body.
% The source below keeps the column structure constant so that the change in
% visual treatment can be assessed directly. Author chips and neutral deadline
% chips keep the same light treatment in both boards; red and amber deadline
% states retain their semantic colors.
%
% \begin{samepage}
% \begin{lstlisting}
% \begin{kanban}[columns={Planned,Active,Complete},mode=light]
%   \kanbantask[prio=high,author=Alice,deadline=01/01/2000]
%     {Planned}{Confirm the requirements}
%   \kanbantask[author=Bob,
%     due=07/18/2026]
%     {Active}{Implement the package interface}
%   \kanbantask[completed,deadline=12/31/2099]
%     {Complete}{Create the test files}
% \end{kanban}
%
% \bigskip
%
% \begin{kanban}[columns={Planned,Active,Complete},mode=dark]
%   \kanbantask[prio=medium,author=Carol,deadline=01/01/2000]
%     {Planned}{Prepare the release notes}
%   \kanbantask[author=David,
%     due=07/18/2026]
%     {Active}{Review the documentation}
%   \kanbantask[completed,deadline=12/31/2099]
%     {Complete}{Select the license}
% \end{kanban}
% \end{lstlisting}
% \end{samepage}
% A document-wide mode may instead be selected as a package option or with
% |\kbset|. The environment option remains the appropriate form when the change
% applies to one board only.
%
% \Needspace{14\baselineskip}
% \paragraph{Rendered output.}
% The following pair is generated from the preceding source. In particular,
% the dark board retains the selected column palette while using transparent
