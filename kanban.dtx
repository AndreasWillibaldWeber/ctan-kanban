% \subsection{Changing the gap between columns}
%
% Column separation follows the same three-level configuration hierarchy as
% the palette and mode. A package option establishes the initial value,
% |\kbset| changes the value for subsequent boards, and an environment option
% applies to one board. The following fragment demonstrates the scope of each
% form:
%
% \begin{samepage}
% \begin{lstlisting}
% \usepackage[columnsep=3mm]{kanban}
%
% % Uses the 3 mm package default.
% \begin{kanban}[columns={Todo,Doing,Done}]
%   \kanbantask[deadline=01/01/2000]{Todo}{Define the interface}
%   \kanbantask[due=07/18/2026]
%     {Doing}{Write the implementation}
%   \kanbantask[deadline=12/31/2099,completed]{Done}{Run the tests}
% \end{kanban}
%
% % Changes the default for subsequent boards.
% \kbset{columnsep=1mm}
% \begin{kanban}[columns={Todo,Doing,Done}]
%   \kanbantask[deadline=01/01/2000]{Todo}{Define the interface}
%   \kanbantask[due=07/18/2026]
%     {Doing}{Write the implementation}
%   \kanbantask[deadline=12/31/2099,completed]{Done}{Run the tests}
% \end{kanban}
%
% % Uses 4 mm here; the document default remains 1 mm.
% \begin{kanban}[columns={Todo,Doing,Done},columnsep=4mm]
%   \kanbantask[deadline=01/01/2000]{Todo}{Define the interface}
%   \kanbantask[due=07/18/2026]
%     {Doing}{Write the implementation}
%   \kanbantask[deadline=12/31/2099,completed]{Done}{Run the tests}
% \end{kanban}
% \end{lstlisting}
% \end{samepage}
% The value must be a nonnegative explicit dimension, such as |2mm|, or one
% registered dimension, such as |\linewidth|. Increasing it strengthens the
% visual separation between workflow stages, but reduces the width available
% to every task card.
%
% \paragraph{Rendered output.}
% In the comparison below, palette, headings, and task content are held
% constant. Only |columnsep| changes. Board-local values are used here so that
% the manual's configuration remains unchanged after the demonstration.
%
% \noindent\textit{Column separation: 3 mm.}
% \begin{kanban}[columns={Todo,Doing,Done},columnsep=3mm]
%   \kanbantask[prio=high,deadline=01/01/2000]
%     {Todo}{Define the interface}
%   \kanbantask[author=Alice,
%     due=07/18/2026]
%     {Doing}{Write the implementation}
%   \kanbantask[completed,deadline=12/31/2099]{Done}{Run the tests}
% \end{kanban}
%
% \medskip
% \noindent\textit{Column separation: 1 mm.}
% \begin{kanban}[columns={Todo,Doing,Done},columnsep=1mm]
%   \kanbantask[prio=high,deadline=01/01/2000]
%     {Todo}{Define the interface}
%   \kanbantask[author=Alice,
%     due=07/18/2026]
%     {Doing}{Write the implementation}
%   \kanbantask[completed,deadline=12/31/2099]{Done}{Run the tests}
% \end{kanban}
%
% \medskip
% \Needspace{8\baselineskip}
% \noindent\textit{Column separation: 4 mm.}
% \begin{kanban}[columns={Todo,Doing,Done},columnsep=4mm]
%   \kanbantask[prio=high,deadline=01/01/2000]
%     {Todo}{Define the interface}
