% \subsection{A page-breakable board}
%
% Long task lists should use the |break| option. In this layout each Kanban
% column is managed as a \textsf{paracol} column and may continue onto a later
% page. The fixed layout, by contrast, treats the complete board as one
% unbreakable object. The compact fragment below shows the public interface;
% the rendered demonstration that follows deliberately contains more cards so
% that a real page transition occurs. The synchronized headings appear once at
% the beginning of the board; continuation pages contain only the remaining
% cards. This behavior follows the public \textsf{paracol} column-stream model
% and avoids dependencies on its private output routine.
%
% \begin{samepage}
% \begin{lstlisting}
% \kbset{palette=default,mode=light,columnsep=2mm}
% \begin{kanban}[
%   columns={Backlog,In progress,Review,Done},break
% ]
%   \kanbantask[prio=high,author=Alice,deadline=01/01/2000]
%     {Backlog}{Finalize the interface}
%   \kanbantask[prio=medium,author=Bob,
%     due=07/18/2026]
%     {In progress}{Write regression tests}
%   \kanbantask[author=Carol,deadline=12/31/2099]
%     {Review}{Proofread the manual}
%   \kanbantask[completed,due=12/31/2099]
%     {Done}{Select the package license}
% \end{kanban}
% \end{lstlisting}
% \end{samepage}
% Task declarations need not follow the order of the columns. The package
% collects each task under its named column and preserves source order within
% that column. Since column bodies paginate independently, their bottom edges
% are not synchronized in this layout.
%
% \paragraph{Rendered output.}
% The next board begins on a fresh page and contains enough material to continue
% onto the following page. Its headings are printed once at the beginning;
% subsequent cards remain in their respective column streams.
%
% \clearpage
% \begin{kanban}[
%   columns={Backlog,In progress,Review},break,columnsep=2mm
% ]
%   \kanbanManualBreakDeadlineCard{Backlog}{Alice}
%     {deadline=01/01/2000}{Confirm the public interface}
